<Window x:Class="CopyChar.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CopyChar" Height="660" Width="1000" MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- A TextBlock keeps underscores visible: as plain Content they are read as access keys (Blizzard_RaidUI). -->
        <DataTemplate x:Key="CheckItem">
            <CheckBox IsChecked="{Binding IsSelected}">
                <TextBlock Text="{Binding Item}" />
            </CheckBox>
        </DataTemplate>
    </Window.Resources>

    <DockPanel Margin="12">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="160" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Game folder" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Grid.Column="1" Text="{Binding InstallPath, Mode=OneWay}" IsReadOnly="True" VerticalContentAlignment="Center" />
            <Button Grid.Column="2" Content="Browse…" Padding="10,2" Margin="8,0" Click="Browse_Click" />
            <TextBlock Grid.Column="3" Text="Version" VerticalAlignment="Center" Margin="8,0" />
            <ComboBox Grid.Column="4" ItemsSource="{Binding Flavors}" SelectedItem="{Binding SelectedFlavor}" />
        </Grid>

        <ListBox DockPanel.Dock="Bottom" ItemsSource="{Binding Log}" Height="100" Margin="0,12,0,0" />

        <TabControl>
            <TabItem Header="Copy settings">
                <DockPanel Margin="8">
                    <Button DockPanel.Dock="Bottom" HorizontalAlignment="Right" Content="Copy" Command="{Binding CopyCommand}"
                            Width="140" Margin="0,8,0,0" Padding="0,6" FontWeight="SemiBold" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="1.3*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <GroupBox Header="1. Source character">
                            <ListBox ItemsSource="{Binding Characters}" SelectedItem="{Binding Source}" BorderThickness="0" />
                        </GroupBox>

                        <GroupBox Grid.Column="2" Header="2. Settings to copy">
                            <DockPanel>
                                <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Categories}"
                                              ItemTemplate="{StaticResource CheckItem}" Margin="4" />
                                <TextBlock DockPanel.Dock="Top" Text="Character-specific addon settings" Margin="4,12,4,0" FontWeight="SemiBold" />
                                <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="4,2,4,4" Foreground="DimGray"
                                           Text="Some addons also keep character progress (quests, guides) in these files." />
                                <ListBox ItemsSource="{Binding Addons}" ItemTemplate="{StaticResource CheckItem}" BorderThickness="0" />
                            </DockPanel>
                        </GroupBox>

                        <GroupBox Grid.Column="4" Header="3. Target characters">
                            <ListBox ItemsSource="{Binding Targets}" ItemTemplate="{StaticResource CheckItem}" BorderThickness="0" />
                        </GroupBox>
                    </Grid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Backups">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="Open folder" Click="OpenBackupFolder_Click" Width="140" Padding="0,6" Margin="0,0,8,0" />
                        <Button Content="Restore" Command="{Binding RestoreCommand}" Width="140" Padding="0,6" FontWeight="SemiBold" />
                    </StackPanel>
                    <ListView ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Date" Width="150" DisplayMemberBinding="{Binding CreatedAt, StringFormat='yyyy-MM-dd HH:mm:ss'}" />
                                <GridViewColumn Header="Backup of" Width="220" DisplayMemberBinding="{Binding Label}" />
                                <GridViewColumn Header="Folder" Width="520" DisplayMemberBinding="{Binding FolderPath}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
