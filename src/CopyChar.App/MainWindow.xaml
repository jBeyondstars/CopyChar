<Window x:Class="CopyChar.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CopyChar" Height="600" Width="900" MinHeight="450" MinWidth="700"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="12">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="160" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Game folder" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Grid.Column="1" Text="{Binding InstallPath, Mode=OneWay}" IsReadOnly="True" VerticalContentAlignment="Center" />
            <Button Grid.Column="2" Content="Browse…" Padding="10,2" Margin="8,0" Click="Browse_Click" />
            <TextBlock Grid.Column="3" Text="Version" VerticalAlignment="Center" Margin="8,0" />
            <ComboBox Grid.Column="4" ItemsSource="{Binding Flavors}" SelectedItem="{Binding SelectedFlavor}" />
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GroupBox Header="Source character">
                <ListBox ItemsSource="{Binding Characters}" SelectedItem="{Binding Source}" BorderThickness="0" />
            </GroupBox>

            <GroupBox Grid.Column="2" Header="Target characters">
                <ListBox ItemsSource="{Binding Targets}" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Item}" IsChecked="{Binding IsSelected}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>
